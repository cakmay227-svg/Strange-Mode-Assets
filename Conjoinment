local function loadModel()
	local objs = game:GetObjects("rbxassetid://" .. MODEL_ID)
	if not objs or #objs == 0 then return nil end

	local model = objs[1]
	model.Name = "Conjoinment" 
	model.Parent = Workspace
	
	local rush = model:FindFirstChild("RushNew", true)
	if not rush then return end

	local att = rush:FindFirstChild("Attachment", true)
	if not att then return end

	-- remove extras
	local footsteps = rush:FindFirstChild("Footsteps")
	if footsteps then footsteps:Destroy() end

	local playSound = rush:FindFirstChild("PlaySound")
	if playSound and playSound:IsA("Sound") then
		playSound.SoundId = "rbxassetid://123114468567866"
		playSound.PlaybackSpeed = 1

		pcall(function()
		playSound.DistortionSoundEffect:Destroy()
			playSound.EqualizerSoundEffect:Destroy()
			playSound.FlangeSoundEffect:Destroy()
			playSound.TremoloSoundEffect:Destroy()
		end)
	end

	for _, v in ipairs(att:GetDescendants()) do
		if v:IsA("ParticleEmitter") then
			v.Texture = "rbxassetid://98931922853035"
		end
	end

	local indicate = rush:FindFirstChild("indicate")
	if indicate then indicate:Destroy() end

	for _, v in ipairs(att:GetChildren()) do
		if v:IsA("PointLight") then
			v.Brightness = 7
			v.Range = 30
			v.Color = Color3.fromRGB(255,0,0)
		end
	end

	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Anchored = true
			v.CanCollide = false
		end
	end
	return model
end

