local function shake(duration,power)

	local start = tick()
	local connection

	connection = RunService.RenderStepped:Connect(function()

		if tick() - start >= duration then
			gui.Position = UDim2.new()
			connection:Disconnect()
			return
		end

		gui.Position = UDim2.new(
			0,
			math.random(-power,power),
			0,
			math.random(-power,power)
		)
	end)
end

