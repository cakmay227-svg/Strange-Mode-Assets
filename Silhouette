---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
	print("Entity has spawned")

	local model = workspace:WaitForChild("Silhouette", 10)
	if not model then return end

	local rush = model:WaitForChild("RushNew", 10)
	if not rush then return end

	local att = rush:WaitForChild("Attachment", 10)
	if not att then return end

	task.wait(0.1)

	-- Footsteps
	local footsteps = rush:FindFirstChild("Footsteps")
	if footsteps then
		footsteps:Destroy()
	end

	-- Main sound
	local playSound = rush:FindFirstChild("PlaySound")
	if playSound and playSound:IsA("Sound") then
		playSound.SoundId = "rbxassetid://0"
		playSound.PlaybackSpeed = 0.1
		playSound.EqualizerSoundEffect:Destroy() 
		playSound.FlangeSoundEffect:Destroy()
		playSound.TremoloSoundEffect:Destroy()
	end

	-- Particle texture
	for _, v in ipairs(att:GetDescendants()) do
		if v:IsA("ParticleEmitter") then
			v.Texture = "rbxassetid://124392954668336"
		end
	end

	-- Remove indicate
	local indicate = rush:FindFirstChild("indicate")
	if indicate then
		indicate:Destroy()
	end

	-- Lấy tất cả PointLight
	local pointLights = {}

	for _, v in ipairs(att:GetChildren()) do
		if v:IsA("PointLight") then
			table.insert(pointLights, v)
		end
	end

	-- Nếu model có 3 PointLight giống như m nói
	if #pointLights >= 3 then
		-- Giữ cái đầu tiên
		pointLights[2]:Destroy()
		pointLights[3]:Destroy()

		pointLights[1].Brightness = 5
		pointLights[1].Range = 25
		pointLights[1].Color = Color3.fromRGB(0,0,0)
	elseif #pointLights >= 1 then
		-- Fallback
		pointLights[1].Brightness = 5
		pointLights[1].Range = 25
		pointLights[1].Color = Color3.fromRGB(0,0,0)
	end
end)

entity:SetCallback("OnStartMoving", function()
