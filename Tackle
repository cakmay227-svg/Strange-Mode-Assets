--------------------------------------------------

local function redJumpscare()

	sound:Play()

	-- FLASH
	flash.BackgroundTransparency = 0

	TweenService:Create(
		flash,
		TweenInfo.new(0.1),
		{
			BackgroundTransparency = 1
		}
	):Play()

	-- RED
	TweenService:Create(
		red,
		TweenInfo.new(0.15),
		{
			BackgroundTransparency = 0.4
		}
	):Play()

	-- NOISE
	TweenService:Create(
		noise,
		TweenInfo.new(0.1),
		{
			ImageTransparency = 0.2
		}
	):Play()

	-- VIGNETTE
	TweenService:Create(
		vignette,
		TweenInfo.new(0.15),
		{
			ImageTransparency = 0.3
		}
	):Play()

	--------------------------------------------------
	-- ENTITY APPEARS FAR AWAY
	--------------------------------------------------

	scare.ImageTransparency = 0
	scare.Size = UDim2.new(0.02,0,0.02,0)
	scare.Position = UDim2.new(0.5,0,0.5,0)

	imageShake(0.25,20)

	local zoomTween = TweenService:Create(
		scare,
		TweenInfo.new(
			0.8,
			Enum.EasingStyle.Exponential,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.new(3.5,0,3.5,0)
		}
	)

	zoomTween:Play()

	--------------------------------------------------
	-- SCREEN SHAKE
	--------------------------------------------------

	shake(0.7,25)

	--------------------------------------------------
	-- FLASH STROBE
	--------------------------------------------------

	task.spawn(function()

		for i = 1,8 do

			flash.BackgroundTransparency = 0

			task.wait(0.02)

			flash.BackgroundTransparency = 1

			task.wait(0.04)
		end
	end)

	--------------------------------------------------
	-- NOISE GLITCH
	--------------------------------------------------

	task.spawn(function()

		for i = 1,15 do

			noise.ImageTransparency =
				math.random(10,35)/100

			task.wait(0.03)
		end
	end)

	task.wait(0.9)

	--------------------------------------------------
	-- FADE OUT
	--------------------------------------------------

	TweenService:Create(
		scare,
		TweenInfo.new(0.5),
		{
			ImageTransparency = 1
		}
	):Play()

	TweenService:Create(
		noise,
		TweenInfo.new(0.5),
		{
			ImageTransparency = 1
		}
	):Play()

	TweenService:Create(
		red,
		TweenInfo.new(0.5),
		{
			BackgroundTransparency = 1
		}
	):Play()

	TweenService:Create(
		vignette,
		TweenInfo.new(0.5),
		{
			ImageTransparency = 1
		}
	):Play()

	task.wait(0.6)

	gui:Destroy()
end

