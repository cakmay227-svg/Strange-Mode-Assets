--------------------------------------------------
-- SCREEN SHAKE
--------------------------------------------------

local function shake(duration,power)

	local start = tick()
	local connection

	connection = RunService.RenderStepped:Connect(function()

		if tick() - start >= duration then
			gui.Position = UDim2.new()
			connection:Disconnect()
			return
		end

		gui.Position = UDim2.new(
			0,
			math.random(-power,power),
			0,
			math.random(-power,power)
		)
	end)
end

--------------------------------------------------
-- IMAGE SHAKE
--------------------------------------------------

local function imageShake(duration,power)

	local start = tick()
	local connection

	connection = RunService.RenderStepped:Connect(function()

		if tick() - start >= duration then
			scare.Position = UDim2.new(0.5,0,0.5,0)
			connection:Disconnect()
			return
		end

		scare.Position = UDim2.new(
			0.5,
			math.random(-power,power),
			0.5,
			math.random(-power,power)
		)
	end)
end

