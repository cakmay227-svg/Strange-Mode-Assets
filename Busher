-- SCREEN SHAKE (UI jitter)
local function shake(duration, power)
	local start = tick()
	local connection

	connection = RunService.RenderStepped:Connect(function()
		if tick() - start > duration then
			connection:Disconnect()
			gui.Position = UDim2.new(0,0,0,0)
			return
		end

		gui.Position = UDim2.new(0, math.random(-power,power), 0, math.random(-power,power))
	end)
end

local function redJumpscare()

	sound:Play()

	-- FIRST FLASH (instant shock)
	flash.BackgroundTransparency = 0
	TweenService:Create(flash, TweenInfo.new(0.1), {
		BackgroundTransparency = 1
	}):Play()

	-- RED FILL IN
	TweenService:Create(red, TweenInfo.new(0.2), {
		BackgroundTransparency = 0.4
	}):Play()

	-- NOISE ON
	TweenService:Create(noise, TweenInfo.new(0.1), {
		ImageTransparency = 0.2
	}):Play()

	-- VIGNETTE IN
	TweenService:Create(vignette, TweenInfo.new(0.2), {
		ImageTransparency = 0.3
	}):Play()

	-- IMAGE POP (FIXED SCALE)
	scare.ImageTransparency = 0
	scare.Size = UDim2.new(0.6,0,0.6,0)

	TweenService:Create(scare, TweenInfo.new(0.12, Enum.EasingStyle.Exponential), {
		Size = UDim2.new(1.05,0,1.05,0)
	}):Play()

	-- HARD SHAKE
	shake(0.6, 25)

	-- STROBE FLASH LOOP
	task.spawn(function()
		for i = 1, 6 do
			flash.BackgroundTransparency = 0
			task.wait(0.03)
			flash.BackgroundTransparency = 1
			task.wait(0.05)
		end
	end)

	-- GLITCH PULSE
	task.spawn(function()
		for i = 1, 10 do
			noise.ImageTransparency = math.random(10,30)/100
			task.wait(0.05)
		end
	end)

	task.wait(0.9)

	-- FADE OUT EVERYTHING (slow suffocation)
	TweenService:Create(scare, TweenInfo.new(0.5), {ImageTransparency = 1}):Play()
	TweenService:Create(noise, TweenInfo.new(0.5), {ImageTransparency = 1}):Play()
	TweenService:Create(red, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
	TweenService:Create(vignette, TweenInfo.new(0.5), {ImageTransparency = 1}):Play()
end

redJumpscare()
	else
