local function spawnInRoom()
	local room = CurrentRooms:FindFirstChild(LatestRoom.Value)
	if not room then
		warn("Room not found:", LatestRoom.Value)
		return
	end

	local floor = getRandomFloor(room)
	if not floor then
		warn("No floor found")
		return
	end

	local model = loadModel()
	if not model then return end

	model.Parent = Workspace
	currentModel = model
	targetModel = model
	
	local rush = model:FindFirstChild("RushNew", true)
	if not rush then return end

	local att = rush:FindFirstChild("Attachment", true)
	if not att then return end

	-- remove extras
	local footsteps = rush:FindFirstChild("Footsteps")
	if footsteps then footsteps:Destroy() end

	local playSound = rush:FindFirstChild("PlaySound")
	if playSound and playSound:IsA("Sound") then
		playSound.SoundId = "rbxassetid://83095014681430"
		playSound.PlaybackSpeed = 0.8

		pcall(function()
		playSound.DistortionSoundEffect:Destroy()
			playSound.EqualizerSoundEffect:Destroy()
			playSound.FlangeSoundEffect:Destroy()
			playSound.TremoloSoundEffect:Destroy()
		end)
	end

	for _, v in ipairs(att:GetDescendants()) do
		if v:IsA("ParticleEmitter") then
			v.Texture = "rbxassetid://93964517655476"
		end
	end

	local indicate = rush:FindFirstChild("indicate")
	if indicate then indicate:Destroy() end

	for _, v in ipairs(att:GetChildren()) do
		if v:IsA("PointLight") then
			v.Brightness = 1
			v.Range = 15
			v.Color = Color3.fromRGB(255,255,255)
		end
	end

	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Anchored = true
			v.CanCollide = false
		end
	end

	local basePos = getRandomPointInPart(floor)

	local _, size = model:GetBoundingBox()
	local spawnY = floor.Position.Y + (floor.Size.Y / 2) + (size.Y * 0.35)

	local finalPos = Vector3.new(basePos.X, spawnY, basePos.Z)

	model:PivotTo(CFrame.new(finalPos))
	setTarget(model)
end

