	:WaitForChild("GameData")
	:WaitForChild("LatestRoom")

local MODEL_ID = 115367508697896
local currentModel = nil

local function getRandomFloor(room)
	local floors = {}

	for _, obj in ipairs(room:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "Floor" then
			table.insert(floors, obj)
		end
	end

	if #floors == 0 then
		return nil
	end

	return floors[math.random(1, #floors)]
end

local function getRandomPointInPart(part)
	local cf = part.CFrame
	local size = part.Size

	local x = (math.random() - 0.5) * size.X
	local z = (math.random() - 0.5) * size.Z

	return (cf * CFrame.new(x, 0, z)).Position
end

local function loadModel()
	local objs = game:GetObjects("rbxassetid://" .. MODEL_ID)

	if not objs or #objs == 0 then
		warn("getObjects fail")
		return nil
	end

	local container = objs[1]

	local model = container:FindFirstChildWhichIsA("Model", true) or container
	container.Parent = nil

	return model
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local DAMAGE = 100
local INTERVAL = 0.5

local targetModel = nil
local lastDamageTime = 0

-- lấy model vừa spawn (gắn từ spawn function)
local function setTarget(model)
	targetModel = model
end

-- raycast check nhìn
local function isLookingAtModel()
	if not targetModel then return false end

	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * 1000

	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {player.Character}
	params.FilterType = Enum.RaycastFilterType.Blacklist

	local result = workspace:Raycast(origin, direction, params)

	if result and result.Instance then
		return result.Instance:IsDescendantOf(targetModel)
	end

	return false
end

